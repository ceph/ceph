[DEFAULT]
port = 8101
host = localhost
zonegroup = zg1
cluster = c1
version = v2

[s3 main]
access_key = 0987654321
secret_key = crayon
display_name = RegularUser
user_id = regular.user
email =

[kerberos]
service_name = kafka
principal = rgw/<broker-fqdn/ip>@REALM.COM
keytab = /etc/krb5-keytabs/rgw.service.keytab

[oauthbearer]
token_endpoint_url = http://127.0.0.1:5556/dex/token
client_id = rgw-notifications
client_secret = client-secret
access_token = <access_token>
scope = openid
