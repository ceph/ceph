#!@Python3_EXECUTABLE@
# -*- mode:python -*-
# vim: ts=4 sw=4 expandtab

import argparse
import errno
import grp
import logging
import os
import pwd
import re
import signal
import socket
import subprocess
import sys
import time

logging.basicConfig(level=logging.INFO)
log = logging.getLogger('ceph-crash')

# ceph's own log lines on stderr start with a timestamp
LOG_LINE = re.compile(r'^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d')

# seconds to reach the cluster, well under the 30 of timeout(1)
CONNECT_TIMEOUT = 5

auth_names = ['client.crash.%s' % socket.gethostname(),
              'client.crash',
              'client.admin']

# the name that worked last, tried first
last_good_name = None


def parse_args():
    parser = argparse.ArgumentParser()
    parser.add_argument(
        '-p', '--path', default='/var/lib/ceph/crash',
        help='base path to monitor for crash dumps')
    parser.add_argument(
        '-d', '--delay', default=10.0, type=float,
        help='minutes to delay between scans (0 to exit after one)',
    )
    parser.add_argument(
        '--name', '-n',
        help='ceph name to authenticate as '
             '(default: try client.crash, client.admin)')
    parser.add_argument(
        '--log-level', '-l',
        help='log level output (default: INFO), support INFO or DEBUG')

    return parser.parse_args()


def command_error(stderr):
    """stderr without ceph's log lines"""
    lines = [line for line in stderr.splitlines() if not LOG_LINE.match(line)]
    return '\n'.join(lines).strip()


def names_to_try():
    if last_good_name is None:
        return auth_names
    return [last_good_name] + [n for n in auth_names if n != last_good_name]


def run_ceph(what, args, input=None):
    global last_good_name
    # a failure with one name says nothing about the next, so try them all
    errors = []
    for n in names_to_try():
        pr = subprocess.Popen(
            args=['timeout', '30', 'ceph',
                  '--connect-timeout', str(CONNECT_TIMEOUT),
                  '--log-stderr-prefix=',
                  '-n', n] + args,
            stdin=subprocess.PIPE,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
        )
        (_, stderr) = pr.communicate(input=input)
        stderr = stderr.decode(errors='replace').strip()
        rc = pr.returncode
        if rc == 0 and command_error(stderr) == '':
            last_good_name = n
            return 0
        log.debug('%s as %s failed: %s' % (what, n, stderr))
        errors.append('%s: %s' % (n, stderr or 'exit code %d' % rc))
        if rc == 0:
            # exited 0 but failed, don't let it pass as posted
            rc = 1
            break
        if rc == errno.EINVAL:
            # the cluster rejected what we sent
            break
    log.warning('%s failed as %s' % (what, '; '.join(errors)))
    return rc


def post_crash(path):
    with open(os.path.join(path, 'meta'), 'rb') as f:
        meta = f.read()
    return run_ceph('post %s' % path, ['crash', 'post', '-i', '-'], meta)


def scrape_path(path):
    for p in os.listdir(path):
        crashpath = os.path.join(path, p)
        if not os.access(crashpath, os.R_OK):
            log.warning('unable to read crash path %s' % (crashpath))
            continue
        metapath = os.path.join(crashpath, 'meta')
        donepath = os.path.join(crashpath, 'done')
        if os.path.isfile(metapath):
            if not os.path.isfile(donepath):
                # hang out just for a bit; either we interrupted the dump
                # or the daemon crashed before finishing it
                time.sleep(1)
                if not os.path.isfile(donepath):
                    return
            # ok, we can process this one
            rc = post_crash(crashpath)
            if rc == 0:
                os.rename(crashpath, os.path.join(path, 'posted/', p))
                log.debug(
                    "posted %s and renamed %s -> %s " %
                    (metapath, p, os.path.join('posted/', p))
                )


def handler(signum, frame):
    print('*** Interrupted with signal %d ***' % signum)
    sys.exit(0)


def drop_privs():
    if os.getuid() == 0:
        try:
            ceph_uid = pwd.getpwnam("ceph").pw_uid
            ceph_gid = grp.getgrnam("ceph").gr_gid
            os.setgroups([])
            os.setgid(ceph_gid)
            os.setuid(ceph_uid)
        except Exception as e:
            log.error(f"Unable to drop privileges: {e}")
            sys.exit(1)


def main():
    global auth_names

    # run as unprivileged ceph user
    drop_privs()

    # exit code 0 on SIGINT, SIGTERM
    signal.signal(signal.SIGINT, handler)
    signal.signal(signal.SIGTERM, handler)

    args = parse_args()
    if args.log_level == 'DEBUG':
        log.setLevel(logging.DEBUG)

    postdir = os.path.join(args.path, 'posted')
    if args.name:
        auth_names = [args.name]

    while not os.path.isdir(postdir):
        log.error("directory %s does not exist; please create" % postdir)
        time.sleep(30)

    log.info("pinging cluster to exercise our key")
    run_ceph('ping', ['-s'])

    log.info("monitoring path %s, delay %ds" % (args.path, args.delay * 60.0))
    while True:
        try:
            scrape_path(args.path)
        except Exception as e:
            log.error(f"Error scraping {args.path}: {e}")
        if args.delay == 0:
            sys.exit(0)
        time.sleep(args.delay * 60)


if __name__ == "__main__":
    main()
