#!/bin/bash
# generated by cephadm
STATUS_FILE="{{ status_file }}"
ENDPOINT_FILE="{{ endpoint_file }}"
echo "{\"status\": \"running\", \"ts\": $(date +%s)}" > "$STATUS_FILE"
CONTAINER=$({{ engine }} ps -q --filter "name={{ container_name }}" 2>/dev/null | head -1)
if [ -z "$CONTAINER" ]; then
    CONTAINER=$({{ engine }} ps -q --filter "name={{ legacy_container_name }}" 2>/dev/null | head -1)
fi
if [ -z "$CONTAINER" ]; then
    echo "container {{ container_name }} not running, skipping metrics push"
    echo "{\"status\": \"skipped\", \"ts\": $(date +%s)}" > "$STATUS_FILE"
    exit 0
fi
ZONE_ID=$({{ engine }} exec -e CEPH_ARGS="{{ ceph_args }}" "$CONTAINER" timeout 60 bash -c {{ (zone_get_cmd ~ ' 2>/dev/null | jq -r .id') | shellquote }})
if [ -z "$ZONE_ID" ] || [ "$ZONE_ID" = "null" ]; then
    echo "failed to resolve zone id, skipping metrics push"
    echo "{\"status\": \"error\", \"reason\": \"zone_id\", \"ts\": $(date +%s)}" > "$STATUS_FILE"
    exit 1
fi
ENDPOINT="{{ endpoint }}/zone/${ZONE_ID}"
# Pushgateway keeps a group until it is deleted. When the zone id changes,
# drop the previous group before replacing it. A failed delete must not
# hide the URL: the next run retries while this file still names it.
OLD_ENDPOINT=""
if [ -f "$ENDPOINT_FILE" ]; then
    OLD_ENDPOINT=$(sed -n 's/^endpoint=//p' "$ENDPOINT_FILE" | head -1)
fi
DELETE_OK=1
if [ -n "$OLD_ENDPOINT" ] && [ "$OLD_ENDPOINT" != "$ENDPOINT" ]; then
    HTTP=$({{ engine }} exec "$CONTAINER" curl -sS -o /dev/null -w '%{http_code}' -X DELETE {% if pushgateway_args %}{{ pushgateway_args }} {% endif %}"$OLD_ENDPOINT" || true)
    case "$HTTP" in
        200|202|404) ;;
        *)
            DELETE_OK=0
            echo "failed to delete previous pushgateway group (http=$HTTP)"
            ;;
    esac
fi
if {{ engine }} exec -e CEPH_ARGS="{{ ceph_args }}" -e PROMETHEUS_PUSHGATEWAY_ENDPOINT="$ENDPOINT" -e PROMETHEUS_PUSHGATEWAY_ARGS="--fail{% if pushgateway_args %} {{ pushgateway_args }}{% endif %}" "$CONTAINER" timeout {{ timeout }} rgw-export-bucket-usage "$ZONE_ID"; then
    if [ "$DELETE_OK" = 1 ]; then
        {
            printf 'endpoint=%s\n' "$ENDPOINT"
            printf 'pushgateway_url=%s\n' {{ pushgateway_url | shellquote }}
            printf 'zone_name=%s\n' {{ zone_name | shellquote }}
        } > "$ENDPOINT_FILE"
    fi
    echo "{\"status\": \"ok\", \"ts\": $(date +%s)}" > "$STATUS_FILE"
else
    RC=$?
    echo "{\"status\": \"error\", \"rc\": $RC, \"ts\": $(date +%s)}" > "$STATUS_FILE"
    exit $RC
fi
