#!/bin/bash
# generated by cephadm
STATUS_FILE="{{ status_file }}"
echo "{\"status\": \"running\", \"ts\": $(date +%s)}" > "$STATUS_FILE"
CONTAINER=$({{ engine }} ps -q --filter "name={{ container_name }}" 2>/dev/null | head -1)
if [ -z "$CONTAINER" ]; then
    CONTAINER=$({{ engine }} ps -q --filter "name={{ legacy_container_name }}" 2>/dev/null | head -1)
fi
if [ -z "$CONTAINER" ]; then
    echo "container {{ container_name }} not running, skipping metrics push"
    echo "{\"status\": \"skipped\", \"ts\": $(date +%s)}" > "$STATUS_FILE"
    exit 0
fi
ZONE_ID=$({{ engine }} exec -e CEPH_ARGS="{{ ceph_args }}" "$CONTAINER" bash -c {{ (zone_get_cmd ~ ' 2>/dev/null | jq -r .id') | shellquote }})
if [ -z "$ZONE_ID" ] || [ "$ZONE_ID" = "null" ]; then
    echo "failed to resolve zone id, skipping metrics push"
    echo "{\"status\": \"error\", \"reason\": \"zone_id\", \"ts\": $(date +%s)}" > "$STATUS_FILE"
    exit 1
fi
ENDPOINT="{{ endpoint }}/zone/${ZONE_ID}"
if {{ engine }} exec -e CEPH_ARGS="{{ ceph_args }}" -e PROMETHEUS_PUSHGATEWAY_ENDPOINT="$ENDPOINT" -e PROMETHEUS_PUSHGATEWAY_ARGS="--fail{% if pushgateway_args %} {{ pushgateway_args }}{% endif %}" "$CONTAINER" rgw-export-bucket-usage "$ZONE_ID"; then
    echo "{\"status\": \"ok\", \"ts\": $(date +%s)}" > "$STATUS_FILE"
else
    RC=$?
    echo "{\"status\": \"error\", \"rc\": $RC, \"ts\": $(date +%s)}" > "$STATUS_FILE"
    exit $RC
fi
