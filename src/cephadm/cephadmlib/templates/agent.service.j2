# generated by cephadm
[Unit]
Description=cephadm agent for cluster {{agent.fsid}}

PartOf=ceph-{{agent.fsid}}.target
Before=ceph-{{agent.fsid}}.target

[Service]
Type=simple
KillMode=control-group
TimeoutStopSec=30
ExecStart=/bin/bash {{agent.daemon_dir}}/unit.run
Restart=on-failure
RestartSec=10s
# The agent exits when its listener can't start. Retry a few times, then
# leave the unit failed; a reconfig or redeploy resets it.
StartLimitInterval=30min
StartLimitBurst=5

[Install]
WantedBy=ceph-{{agent.fsid}}.target
