# generated by cephadm
[Unit]
Description=Ceph {{ job_description }} timer for {{ fsid }}
PartOf=ceph-{{ fsid }}.target

[Timer]
OnActiveSec={{ on_active_sec | default(interval_sec, true) }}s
OnUnitInactiveSec={{ interval_sec }}s
AccuracySec=1min
{%- if randomized_delay_sec %}
RandomizedDelaySec={{ randomized_delay_sec }}s
{%- endif %}

[Install]
WantedBy=ceph-{{ fsid }}.target
