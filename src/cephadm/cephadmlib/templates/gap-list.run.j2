#!/bin/bash
# generated by cephadm
STATUS_FILE="{{ status_file }}"
echo "{\"status\": \"running\", \"ts\": $(date +%s)}" > "$STATUS_FILE"
# The timer can fire while the container is briefly down (e.g. just after a
# reboot or a redeploy), so retry for a short while before giving up rather
# than skipping and waiting for the next interval.
for _ in $(seq 1 6); do
    CONTAINER=$({{ engine }} ps -q --filter "name=^{{ container_name }}$" 2>/dev/null | head -1)
    if [ -z "$CONTAINER" ]; then
        CONTAINER=$({{ engine }} ps -q --filter "name=^{{ legacy_container_name }}$" 2>/dev/null | head -1)
    fi
    [ -n "$CONTAINER" ] && break
    sleep 5
done
if [ -z "$CONTAINER" ]; then
    echo "container {{ container_name }} not running, skipping gap-list scan"
    echo "{\"status\": \"skipped\", \"ts\": $(date +%s)}" > "$STATUS_FILE"
    exit 0
fi
if ! {{ engine }} exec "$CONTAINER" /bin/sh -c 'command -v /usr/bin/rgw-gap-list.py' >/dev/null 2>&1; then
    echo "rgw-gap-list.py not found in container image, skipping scan"
    echo "{\"status\": \"skipped\", \"reason\": \"script_missing\", \"ts\": $(date +%s)}" > "$STATUS_FILE"
    exit 0
fi
if {{ engine }} exec -e CEPH_ARGS="{{ ceph_args }}" "$CONTAINER" timeout --kill-after={{ kill_after }}s {{ timeout }}s /usr/bin/rgw-gap-list.py {{ opts }}; then
    echo "{\"status\": \"ok\", \"ts\": $(date +%s)}" > "$STATUS_FILE"
else
    RC=$?
    echo "{\"status\": \"error\", \"rc\": $RC, \"ts\": $(date +%s)}" > "$STATUS_FILE"
    exit $RC
fi
