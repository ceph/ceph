[Unit]
Description=Ceph FUSE client
After=network-online.target local-fs.target time-sync.target
Wants=network-online.target local-fs.target time-sync.target
Conflicts=umount.target
PartOf=ceph-fuse.target

[Service]
CapabilityBoundingSet=~CAP_SYS_MODULE CAP_SYSLOG
EnvironmentFile=-@SYSTEMD_ENV_FILE@
ExecStart=@CMAKE_INSTALL_PREFIX@/bin/ceph-fuse -f %I
LockPersonality=true
MemoryDenyWriteExecute=true
NoNewPrivileges=true
# ceph-fuse requires access to /dev fuse device
PrivateDevices=no
# a private mount namespace would hide the FUSE mount on %I from the host
ProtectControlGroups=false
ProtectHostname=true
ProtectKernelLogs=false
ProtectKernelModules=false
ProtectKernelTunables=false
Restart=on-failure
RestrictSUIDSGID=true
StartLimitBurst=3
StartLimitInterval=30min
SystemCallFilter=~@module syslog
TasksMax=infinity

[Install]
WantedBy=ceph-fuse.target
