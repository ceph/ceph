# The experimental backends are mutually exclusive and never affect core users.
set(LIBFDB_EXPERIMENTAL_CONCURRENCY "OFF" CACHE STRING
 "Experimental libfdb concurrency backend: OFF, ASIO or NVIDIA_STDEXEC")
set_property(CACHE LIBFDB_EXPERIMENTAL_CONCURRENCY PROPERTY STRINGS
 OFF ASIO NVIDIA_STDEXEC)

set(_libfdb_concurrency_backends OFF ASIO NVIDIA_STDEXEC)
if(NOT LIBFDB_EXPERIMENTAL_CONCURRENCY IN_LIST _libfdb_concurrency_backends)
 message(FATAL_ERROR
  "LIBFDB_EXPERIMENTAL_CONCURRENCY must be OFF, ASIO or NVIDIA_STDEXEC")
endif()

if(NOT LIBFDB_EXPERIMENTAL_CONCURRENCY STREQUAL "OFF" AND NOT WITH_RADOSGW_FDB)
 message(FATAL_ERROR
  "LIBFDB_EXPERIMENTAL_CONCURRENCY requires WITH_RADOSGW_FDB=ON")
endif()

if(EXPERIMENTAL_NVIDIA_STDEXEC)
 message(FATAL_ERROR
  "Replace EXPERIMENTAL_NVIDIA_STDEXEC with LIBFDB_EXPERIMENTAL_CONCURRENCY=NVIDIA_STDEXEC")
endif()
